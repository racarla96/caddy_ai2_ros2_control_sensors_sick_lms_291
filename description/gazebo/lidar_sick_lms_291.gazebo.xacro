<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

<!-- http://sdformat.org/spec?ver=1.8&elem=sensor#sensor_lidar -->

  <xacro:macro name="lidar_sick_lms_291_gazebo">

    <gazebo>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>

    <gazebo reference="ray_link">
      <sensor name="sick_lms_291" type="gpu_lidar">
        <gz_frame_id>ray_link</gz_frame_id> <!-- Ignore Warnings when executing -->
        <topic>/sick_lms_291/scan</topic>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>180</samples> <!-- 180º con 1.0º resolución -->
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>0.1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.01</min>
            <max>80.0</max>
            <resolution>0.01</resolution>
          </range>
          <frame_id>/ray_link</frame_id>
        </lidar>
        <alwaysOn>true</alwaysOn> <!-- Ignore Warnings when executing -->
        <visualize>true</visualize> <!-- Ignore Warnings when executing -->
    </sensor>
    </gazebo>

  </xacro:macro>
</robot>