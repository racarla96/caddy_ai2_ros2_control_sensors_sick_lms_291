{#
  Fragment: injectable into a <model> block.

  The link origin is at the laser aperture (optical window).
  Visual, collision and inertial are offset -0.025 m in Z to match the physical body.

  Hardcoded sensor constants:
    mass = 4.5 kg  |  frame_id = lidar_sick_lms_291_link
    range: 0.01 – 80.0 m  |  noise: gaussian mean=0 stddev=0.01

  Variables always required:
    prefix, parent_link, x, y, z, roll, pitch, yaw, mesh_uri
    include_parent_joint (default true)
    with_sensor          (default true)

  Additional variables required only when with_sensor=true:
    namespace, angle_min, angle_max, resolution, frequency, use_gpu, noise_enabled,
    range_min, range_max
#}
{% if with_sensor | default(true) %}
{% set PI = 3.14159265358979 %}
{% set angle_min_rad = angle_min * PI / 180.0 %}
{% set angle_max_rad = angle_max * PI / 180.0 %}
{% set samples = ((angle_max - angle_min) / resolution) | int %}
{% endif %}

{% if parent_link == "map" %}
  <link name="{{ parent_link }}"/>
{% endif %}

  <link name="{{ prefix }}lidar_sick_lms_291_link">
{% if include_parent_joint | default(true) %}
    <pose>{{ x }} {{ y }} {{ z }} {{ roll }} {{ pitch }} {{ yaw }}</pose>
{% else %}
    <pose>0 0 0 0 0 0</pose>
{% endif %}
    <visual name="{{ prefix }}lidar_visual">
      <pose>0 0 -0.025 0 0 -1.5708</pose>
      <geometry>
        <mesh>
          <uri>{{ mesh_uri }}</uri>
          <scale>1 1 1</scale>
        </mesh>
      </geometry>
    </visual>
    <collision name="{{ prefix }}lidar_collision">
      <pose>0.000 -0.015 0.050 0 0 0</pose>
      <geometry>
        <box><size>0.155 0.156 0.208</size></box>
      </geometry>
    </collision>
    <inertial>
      <pose>-0.000 -0.022 0.043 0 0 0</pose>
      <mass>4.5</mass>
      <inertia>
        <ixx>0.021158</ixx><ixy>-0.000001</ixy><ixz>-0.000001</ixz>
        <iyy>0.021189</iyy><iyz>-0.000882</iyz><izz>0.015449</izz>
      </inertia>
    </inertial>
{% if with_sensor | default(true) %}
    <sensor name="{{ prefix }}sick_lms_291" type="{{ 'gpu_lidar' if use_gpu else 'lidar' }}">
      <gz_frame_id>{{ prefix }}lidar_sick_lms_291_link</gz_frame_id>
{% if namespace %}
      <topic>/{{ namespace }}/sick_lms_291/scan</topic>
{% else %}
      <topic>/sick_lms_291/scan</topic>
{% endif %}
      <update_rate>{{ frequency }}</update_rate>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>{{ samples }}</samples>
            <resolution>1</resolution>
            <min_angle>{{ angle_min_rad }}</min_angle>
            <max_angle>{{ angle_max_rad }}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>{{ range_min }}</min>
          <max>{{ range_max }}</max>
          <resolution>0.01</resolution>
        </range>
{% if noise_enabled %}
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
{% endif %}
      </lidar>
      <always_on>true</always_on>
    </sensor>
{% endif %}
  </link>

  <joint name="{{ prefix }}lidar_joint" type="fixed">
    <parent>{{ parent_link }}</parent>
    <child>{{ prefix }}lidar_sick_lms_291_link</child>
  </joint>
